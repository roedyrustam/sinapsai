{
  "name": "sinapsai",
  "version": "2.8.1",
  "description": "Zero-dependency in-process AI Gateway & Control Plane with Circuit Breaker, MCP Tool Bridge, Autonomous Agent Loop, Rate Limiting, PII/Security Guardrails, KV-Cache Tracking, and Unified LLM API for Node.js, Edge & TypeScript",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workerd": "./dist/index.js",
      "edge-light": "./dist/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk/index.d.ts",
      "workerd": "./dist/ai-sdk/index.js",
      "edge-light": "./dist/ai-sdk/index.js",
      "import": "./dist/ai-sdk/index.js",
      "require": "./dist/ai-sdk/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.id.md",
    "CHANGELOG.md",
    "LICENSE",
    "CONTRIBUTING.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roedyrustam/sinapsai.git"
  },
  "bugs": {
    "url": "https://github.com/roedyrustam/sinapsai/issues"
  },
  "homepage": "https://github.com/roedyrustam/sinapsai#readme",
  "keywords": [
    "ai",
    "llm",
    "ai-gateway",
    "llm-gateway",
    "circuit-breaker",
    "failover",
    "load-balancer",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "vercel-ai-sdk",
    "rate-limiter",
    "prompt-caching",
    "pii-redaction",
    "security-guardrails",
    "opentelemetry",
    "prometheus",
    "embeddings",
    "vector-search",
    "openai",
    "anthropic",
    "gemini",
    "deepseek",
    "ollama",
    "groq",
    "openrouter",
    "xai",
    "cohere",
    "mistral",
    "edge",
    "cloudflare-workers",
    "bun",
    "deno",
    "fault-tolerance",
    "in-memory",
    "control-plane",
    "typescript",
    "developer-tools",
    "resilience"
  ],
  "author": "Roedy Rustam",
  "license": "MIT",
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declaration",
    "dev": "tsup --watch",
    "lint": "biome check --write src/",
    "lint:fix": "biome check --write src/",
    "format": "biome check --write src/",
    "typecheck": "tsc --noEmit && tsc --noEmit --project examples/tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.3",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
