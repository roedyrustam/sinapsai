{
  "name": "sinapsai",
  "version": "2.12.0",
  "description": "Zero-dependency in-process AI Gateway & Control Plane with Universal LLM Optimization (LLMO), Multi-Agent Swarm, A2A Handoff Protocol, MCP Tool Bridge, Autonomous Agent Loop, Circuit Breaker, Rate Limiting, PII/Security Guardrails, KV-Cache Tracking, and Unified LLM API for Node.js, Edge & TypeScript",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workerd": "./dist/index.js",
      "edge-light": "./dist/index.js",
      "bun": "./dist/index.js",
      "deno": "./dist/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./ai-sdk": {
      "types": "./dist/ai-sdk/index.d.ts",
      "workerd": "./dist/ai-sdk/index.js",
      "edge-light": "./dist/ai-sdk/index.js",
      "bun": "./dist/ai-sdk/index.js",
      "deno": "./dist/ai-sdk/index.js",
      "import": "./dist/ai-sdk/index.js",
      "require": "./dist/ai-sdk/index.cjs",
      "default": "./dist/ai-sdk/index.js"
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "ai-sdk": ["dist/ai-sdk/index.d.ts"]
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "README.id.md",
    "CHANGELOG.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "llms.txt",
    "llms-full.txt",
    "BLUEPRINT.md",
    "DOKUMENTASI.md"
  ],
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0",
    "deno": ">=2.0.0"
  },
  "packageManager": "npm@10.9.2",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "funding": [
