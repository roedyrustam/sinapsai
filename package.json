{
  "name": "sinapsai",
  "version": "1.3.0",
  "description": "Blazing-fast in-process AI Gateway & Control Plane with Circuit Breaker, Failover, and Unified LLM API for Node.js & TypeScript",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "workerd": "./dist/index.js",
      "edge-light": "./dist/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.id.md",
    "LICENSE",
    "CONTRIBUTING.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/roedyrustam/sinapsai.git"
  },
  "bugs": {
    "url": "https://github.com/roedyrustam/sinapsai/issues"
  },
  "homepage": "https://github.com/roedyrustam/sinapsai#readme",
  "keywords": [
    "ai",
    "llm",
    "ai-gateway",
    "llm-gateway",
    "circuit-breaker",
    "failover",
    "load-balancer",
    "openai",
    "anthropic",
    "gemini",
    "deepseek",
    "ollama",
    "groq",
    "openrouter",
    "edge",
    "cloudflare-workers",
    "bun",
    "deno",
    "fault-tolerance",
    "in-memory",
    "control-plane",
    "typescript",
    "developer-tools",
    "resilience"
  ],
  "author": "Roedy Rustam",
  "license": "CC-BY-4.0",
  "scripts": {
    "build": "tsup && tsc --emitDeclarationOnly --declaration",
    "dev": "tsup --watch",
    "lint": "biome check --write src/",
    "lint:fix": "biome check --write src/",
    "format": "biome check --write src/",
    "test": "vitest run",
    "prepublishOnly": "npm test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^26.6.3",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
